# ============================================================
# 上交所医疗器械财报 RAG —— 环境变量模板
# 用法：cp .env.example .env  然后填入真实 key
# .env 已在 .gitignore 中，切勿提交
# ============================================================

# ---------------- LLM（生成答案）----------------
# 本机无 NVIDIA GPU，本地跑大模型不现实，一律走 API。
# 下面三选一，把 BASE_URL 换成对应厂商即可。

# 选项 A：DeepSeek（中文财报场景性价比高）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 选项 B：通义千问（DashScope 的 OpenAI 兼容端点）
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 选项 C：OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ---------------- Embedding（向量化）----------------
# 用本地模型目录，不走任何在线 Embedding API。
# Qwen3-Embedding-0.6B：原生 1024 维，查询侧走 prompt_name="query"。
# 权重已放在 models/Qwen3-Embedding-0.6B/（约 1.19GB），无需联网下载。
EMBEDDING_MODEL=models/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
# 留空 = 自动检测（cuda → mps → cpu）。本机无 NVIDIA 卡，实际会落到 cpu。
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=4
# 实测本机 CPU：bs=4 → 165 tok/s，bs=8 → 159，bs=16 → 129，bs=32 → 111。
# 越小越快（CPU 内存带宽/缓存吃紧），所以不要往上调。
# 截断上限。**不是加速开关**：本语料最长只有 8913 token（中位 381），从未接近
# 模型原生 32768。调小等于按 token 丢弃正文 —— cap=512 会切掉 58.7% 的散文块
# （含第三节"变动原因"），实测只省 0.5 小时。定 1024：只切最长的 286 个表格。
EMBEDDING_MAX_SEQ_LENGTH=1024
# 每批的 token 上限（批内最长条 × 条数）。编码按 token 长度排序分桶，
# 这个上限防止 8913 token 的超长表格块把批撑爆内存。CPU 上算力就是 padding，
# 排序后有效占比从 29% 提到 91%，是 5 小时 vs 35 小时的差别。
EMBEDDING_TOKEN_BUDGET=24576

# ---------------- 检索参数 ----------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# 每路召回深度与最终证据数。20/20/6 是需求所定，也是 config.py 的默认值。
# ⚠ 别为了救某道题去调大深度：实测「联影医疗 2026 上半年营业收入」的答案块
#   688271-0009 在**正文索引**上的全库排名是 BM25 #795 / 向量 #541 —— 深度取
#   20、50、100 都进不了池子，软加权更不生效（加权只能在池内重排）。
#   曾经的「第 24 名、取 50 就够」是误记，已实测推翻。
#   要救这类题请改用下面两条（都已实现、都已实测）：
#     A. INDEX_DIR=./index/header —— 索引文本换成「公司+代码+报告+章节+小节+正文」，
#        需要先建：python src/indexing/build_index.py --header（约 4 小时）
#     B. 条件筛选题走结构化表组路由（STRUCTURED_ROUTING，默认开，免重算）
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_FINAL=6
RERANK_ENABLED=false

# ---------------- 结构化表组路由（条件筛选类问题）----------------
# 「17 家公司里……的有哪几家」要的是**全部公司的同一张表**，不是「最相似的 6 条」，
# 所以由元数据直接定位表组（不参与打分）。实测：条件筛选题 hit@10 0→1.000、
# 证据覆盖 17/17 家公司，其余题型一条不变（见 evaluation/results/）。
# 代价：这类问题的证据数不再是 TOP_K_FINAL，而是「17 家公司各 1 张 + TOP_K_FINAL
# 条相似度补充」。少一家就会漏一个正确答案，所以这里是刻意放宽的。
STRUCTURED_ROUTING=true
STRUCTURED_SUBSECTION=主要会计数据
STRUCTURED_SUPPLEMENT=6

# ---------------- 路径 ----------------
DATA_DIR=./data
RAW_DIR=./data/raw
PDF_DIR=./data/pdf
PROCESSED_DIR=./data/processed
# 索引变体：
#   ./index        正文索引（默认；未加 --header 建的）
#   ./index/header 「公司+代码+报告+章节+小节 + 正文」索引（建法见上）
# 两套的 chunk_id 行序完全相同，可以用同一套评测题直接 before/after 对比。
INDEX_DIR=./index
EVAL_DIR=./evaluation

# ---------------- 采集（初期小规模，别全量拉）----------------
# 单次请求间隔秒数，避免给上交所网站压力
DOWNLOAD_DELAY=1.0
DOWNLOAD_MAX_RETRY=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) Financial-RAG-Coursework/0.1
